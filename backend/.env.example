# KABOSS Inc Backend — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Server
PORT=3001
NODE_ENV=production

# CORS origins — set to your production domains
FRONTEND_URL=https://kabossinc.com
ADMIN_URL=https://admin.kabossinc.com

# MySQL Database (Sequelize)
# Use DATABASE_URL for a single connection string, or DB_* for individual parts.
DATABASE_URL=mysql://user:password@localhost:3306/kaboss
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kaboss

# JWT (required — use a strong random secret)
JWT_SECRET=

# MTN MoMo Rwanda (production: set MTN_ENVIRONMENT=live)
MTN_ENVIRONMENT=sandbox
MTN_TARGET_ENV=sandbox
MTN_CURRENCY=RWF
MTN_CONSUMER_KEY=
MTN_CONSUMER_SECRET=
MTN_API_USER=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY=
MTN_MOMO_PAYEE_NUMBER=
MTN_PROVIDER_CALLBACK_HOST=
MTN_CALLBACK_URL=

# SMTP (optional — for future password reset email feature)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
