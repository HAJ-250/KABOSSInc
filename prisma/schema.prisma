generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum BookingStatus {
  pending
  approved
  in_progress
  completed
  cancelled
}

enum ConversationStatus {
  active
  archived
  completed
}

model User {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  email         String?  @unique @db.VarChar(255)
  username      String?  @unique @db.VarChar(255)
  password      String   @db.VarChar(255)
  displayName   String   @db.VarChar(255)
  role          UserRole @default(customer)
  phone         String?  @db.VarChar(255)
  emailVerified Boolean  @default(false) @db.Bool
  isActive      Boolean  @default(true) @db.Bool
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt @db.DateTime(0)

  bookings      Booking[]
  messages      Message[]

  @@map("Users")
}

model Service {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  title       String   @db.VarChar(255)
  category    String?  @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @db.Bool
  createdAt   DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @updatedAt @db.DateTime(0)

  bookings    Booking[]

  @@map("Services")
}

model Booking {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  userId      Int         @db.UnsignedInt
  serviceId   Int         @db.UnsignedInt
  serviceName String      @db.VarChar(255)
  details     String      @db.Text
  date        String      @db.VarChar(255)
  time        String?     @db.VarChar(255)
  location    String?     @db.VarChar(255)
  status      BookingStatus @default(pending)
  createdAt   DateTime    @default(now()) @db.DateTime(0)
  updatedAt   DateTime    @updatedAt @db.DateTime(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@map("Bookings")
}

model Contact {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(255)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false) @db.Bool
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  @@map("Contacts")
}

model Conversation {
  id           Int              @id @default(autoincrement()) @db.UnsignedInt
  subject      String?          @db.VarChar(255)
  participants String?          @db.Text
  lastMessage  String?          @db.Text
  lastMessageAt DateTime?       @db.DateTime(0)
  status       ConversationStatus @default(active)
  createdAt    DateTime         @default(now()) @db.DateTime(0)
  updatedAt    DateTime         @updatedAt @db.DateTime(0)

  messages Message[]

  @@map("Conversations")
}

model Message {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  conversationId Int     @db.UnsignedInt
  senderId      Int      @db.UnsignedInt
  senderName    String?  @db.VarChar(255)
  content       String   @db.Text
  isRead        Boolean  @default(false) @db.Bool
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt @db.DateTime(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("Messages")
}

model FAQ {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  question  String   @db.Text
  answer    String   @db.Text
  category  String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true) @db.Bool
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  @@map("FAQs")
}

model Partner {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @db.VarChar(255)
  description String?  @db.Text
  logo        String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @db.Bool
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @updatedAt @db.DateTime(0)

  @@map("Partners")
}

model Testimonial {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @db.VarChar(255)
  role      String?  @db.VarChar(255)
  content   String   @db.Text
  rating    Int      @default(5)
  isActive  Boolean  @default(true) @db.Bool
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  @@map("Testimonials")
}

model Announcement {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  title     String   @db.VarChar(255)
  content   String   @db.Text
  type      String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @db.Bool
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  @@map("Announcements")
}

model Settings {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  key       String   @unique @db.VarChar(255)
  value     String   @db.Text
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  @@map("Settings")
}
